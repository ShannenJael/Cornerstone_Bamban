# Netlify Functions storage. Netlify sets these automatically in production.
# For local direct-node testing, the functions fall back to .netlify/local-blobs.
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# JSON object of username/password pairs.
# Example: {"name@example.com":"change-me"}
MEDIA_USERS_JSON=
MISSIONS_USERS_JSON=
VISITATION_ADMIN_USERS_JSON=
USHERS_USERS_JSON=

# Used to sign lightweight cookies for function-served protected pages.
SESSION_SECRET=

# YouTube API proxy. Set this in Netlify instead of exposing a key in browser code.
YOUTUBE_API_KEY=

# Optional webhook used by send-email and volunteer signup functions.
CONTACT_WEBHOOK_URL=
CONTACT_TO_EMAIL=
